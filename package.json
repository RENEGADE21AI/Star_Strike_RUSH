{
  "name": "star-strike-rush",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "generate:achievements": "node scripts/generate-achievements.js",
    "check:achievements": "node scripts/generate-achievements.js --check",
    "build": "npm run check:achievements && node scripts/build_static.js",
    "test": "npm run check:achievements && node --test tests/*.test.js",
    "test:browser": "node --test tests/browser-gameplay.test.js",
    "test:rules": "npx firebase emulators:exec --only firestore \"node --test tests/firestore-rules.emulator.mjs\"",
    "test:firebase-client": "node scripts/run-firebase-client-emulator.js",
    "test:visual": "node scripts/visual_qa.js",
    "test:secret": "node scripts/secret_scan.js",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -CheckOnly -ExpectedBranch \"*\"",
    "deploy:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -StageBackendPreview -ExpectedBranch main",
    "deploy:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -Production -ApprovalFile release-approval.local.json -ExpectedBranch main"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.16.0",
    "firebase-tools": "15.24.0",
    "playwright": "1.61.1"
  }
}
